---
import { Monitor, Moon, Sun } from 'lucide-react'
import { GITHUB } from '../lib/release'
---
<header class="nav">
  <div class="wrap nav-in">
    <a class="nav-logo" href="#top" aria-label="Snapkit home">
      <img src="/logo.svg" alt="" width="28" height="28" />
      <span>Snapkit</span>
    </a>
    <nav class="nav-links" aria-label="Sections">
      <a href="#features">Features</a>
      <a href="#faq">FAQ</a>
      <a href="#changelog">Changelog</a>
      <a href={GITHUB}>GitHub</a>
    </nav>
    <div class="theme" role="radiogroup" aria-label="Color theme" data-theme-switch>
      <button type="button" role="radio" data-set="system" aria-label="System theme" title="System"><Monitor size={15} /></button>
      <button type="button" role="radio" data-set="light" aria-label="Light theme" title="Light"><Sun size={15} /></button>
      <button type="button" role="radio" data-set="dark" aria-label="Dark theme" title="Dark"><Moon size={15} /></button>
    </div>
    <a class="btn btn-primary btn-sm" href="#download">Download</a>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 94%, transparent);
    -webkit-backdrop-filter: saturate(1.8) blur(28px); backdrop-filter: saturate(1.8) blur(28px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .nav-in { height: 64px; display: flex; align-items: center; gap: 24px; }
  .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 650; letter-spacing: -.02em; font-size: 17px; }
  .nav-logo img { border-radius: 7px; }
  .nav-links { display: flex; gap: 4px; margin-left: 8px; }
  .nav-links a { text-decoration: none; font-size: 14px; color: var(--muted); padding: 6px 10px; border-radius: 8px; }
  .nav-links a:hover { color: var(--fg); background: var(--bg-soft); }
  .theme { margin-left: auto; display: inline-flex; gap: 2px; padding: 3px; border-radius: 999px; background: var(--bg-soft); box-shadow: inset 0 0 0 1px var(--line); }
  .theme button { width: 30px; height: 30px; display: grid; place-items: center; border: 0; border-radius: 999px; background: transparent; color: var(--muted); cursor: pointer; }
  .theme button:hover { color: var(--fg); }
  .theme button[aria-checked='true'] { background: var(--card); color: var(--fg); box-shadow: var(--shadow-s); }
  @media (max-width: 640px) { .nav-links { display: none; } }
  @media (max-width: 480px) { .nav .btn { display: none; } .nav-in { gap: 12px; } }
</style>

<script>
  // System follows the OS; Light or Dark is remembered in this browser (applied early by Base.astro).
  for (const group of document.querySelectorAll<HTMLElement>('[data-theme-switch]')) {
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-set]')]
    const show = () => {
      const current = document.documentElement.dataset.theme ?? 'system'
      for (const b of buttons) b.setAttribute('aria-checked', String(b.dataset.set === current))
    }
    for (const b of buttons) {
      b.addEventListener('click', () => {
        const t = b.dataset.set!
        if (t === 'system') delete document.documentElement.dataset.theme
        else document.documentElement.dataset.theme = t
        try {
          if (t === 'system') localStorage.removeItem('theme')
          else localStorage.setItem('theme', t)
        } catch {}
        show()
      })
    }
    show()
  }
</script>
