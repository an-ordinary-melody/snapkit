---
import { GITHUB } from '../lib/release'

const QA: { q: string; a: string }[] = [
  {
    q: 'Is it really free?',
    a: 'Yes. Snapkit is open source under the MIT license: no account, no ads, no paid tier, no trial. You can read, change and redistribute the code.'
  },
  {
    q: 'Can it replace my current screenshot app?',
    a: "If you're on a Mac, there are more polished apps, such as <a href=\"https://shottr.cc/\">Shottr</a>, <a href=\"https://macshot.io/\">macshot</a>, <a href=\"https://snapzy.app/\">Snapzy</a>, etc. But if you enjoy a minimal, customizable experience, and want the same app on Windows too, give Snapkit a try."
  },
  {
    q: 'Does it send my screenshots anywhere?',
    a: 'No. Captures, history and settings stay on your computer. The only thing Snapkit asks the internet for is a once-a-day check of GitHub for a new version. Clearing history really deletes the files.'
  },
  {
    q: 'Is it safe to install?',
    a: `The code is public on <a href="${GITHUB}">GitHub</a>, and every installer is built from it by GitHub Actions. Inside the app, windows are sandboxed, only accept messages from Snapkit's own pages, and can't open web pages; the packaged app has Electron's run-as-Node and debugging switches turned off.`
  },
  {
    q: 'How do I install it on a Mac?',
    a: 'Open the .dmg and drag Snapkit to Applications. Snapkit isn\'t signed with a paid Apple Developer ID yet, so macOS blocks the first launch: open it once, then go to <b>System Settings → Privacy & Security</b> and click <b>Open Anyway</b>. (Or run <code>xattr -cr /Applications/Snapkit.app</code> in Terminal.) Allow <b>Screen Recording</b> when asked, then quit and reopen Snapkit.'
  },
  {
    q: 'How do I install it on Windows?',
    a: 'Run the setup .exe. SmartScreen warns about an unknown publisher because the installer isn\'t signed yet: click <b>More info → Run anyway</b>.'
  },
  {
    q: 'Why does it need Screen Recording permission?',
    a: 'That\'s how macOS lets any app read what\'s on screen, which a screenshot tool has to do. Snapkit only reads the screen when you start a capture. After an update macOS may ask again; if captures only show the wallpaper, remove Snapkit from the list with – and add it back.'
  },
  {
    q: 'Intel Mac? Linux?',
    a: 'Right now there are builds for Apple Silicon Macs and 64-bit Windows. Since it\'s open source, you can build it for other systems yourself.'
  },
  {
    q: 'How do updates work?',
    a: 'Snapkit tells you when a new version is out (a notification and an item in the menu-bar menu) and downloads the installer for you to open. Nothing installs by itself.'
  },
  {
    q: 'Where do I report a bug or ask for a feature?',
    a: `On <a href="${GITHUB}/issues">GitHub Issues</a>. On Windows, please attach the log file (<code>%APPDATA%\\Snapkit\\logs\\main.log</code>) if you can.`
  }
]
---
<section id="faq">
  <div class="wrap faq-in">
    <div class="section-head">
      <span class="eyebrow"><i class="dot"></i> Questions and answers</span>
      <h2>Good to <span class="serif">know.</span></h2>
    </div>
    <div class="faq">
      {QA.map(({ q, a }, i) => (
        <details name="faq" open={i === 0}>
          <summary>{q}</summary>
          <p set:html={a} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-in { max-width: 820px; }
  .faq { display: grid; gap: 8px; }
  details { border-radius: 16px; background: var(--card); box-shadow: inset 0 0 0 1px var(--line); transition: background .2s; }
  details[open] { background: var(--bg-soft); }
  summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px;
    font-weight: 600; font-size: 16px; letter-spacing: -.01em;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: ''; width: 10px; height: 10px; flex: none; border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted);
    transform: rotate(45deg) translate(-2px, -2px); transition: transform .2s;
  }
  details[open] summary::after { transform: rotate(-135deg) translate(-2px, -2px); }
  details p { padding: 0 20px 20px; color: var(--muted); font-size: 15px; }
  details :global(code) { font: 13px var(--mono); padding: 2px 6px; border-radius: 6px; background: var(--card); box-shadow: inset 0 0 0 1px var(--line); word-break: break-word; }
  details :global(b) { color: var(--fg-2); font-weight: 600; }
  details :global(a) { color: var(--fg); }
</style>
