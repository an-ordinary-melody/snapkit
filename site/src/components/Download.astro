---
// Download for macOS / Windows. The visitor's OS goes first (set by the script in index.astro).
import type { Latest } from '../lib/release'
import OsIcon from './OsIcons.astro'

interface Props { latest: Latest; note?: boolean }
const { latest, note = true } = Astro.props
---
<div class="dl">
  <div class="dl-row" data-dl>
    <a class="btn btn-primary" data-os="mac" href={latest.mac} rel="nofollow">
      <OsIcon os="mac" /> Download for macOS
    </a>
    <a class="btn btn-secondary" data-os="win" href={latest.win} rel="nofollow">
      <OsIcon os="win" /> Download for Windows
    </a>
  </div>
  {note && (
    <p class="dl-note">
      {latest.version && <a href={latest.page}>v{latest.version}</a>}
      <span>·</span> Apple Silicon <span>·</span> Windows x64 <span>·</span> Free, MIT license
    </p>
  )}
</div>

<style>
  .dl { display: grid; gap: 14px; justify-items: center; }
  .dl-row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .dl-note { font-size: 13px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
  .dl-note a { text-decoration: none; font-weight: 550; color: var(--fg-2); }
  .dl-note a:hover { text-decoration: underline; }
  .dl-note span { opacity: .5; }
  @media (max-width: 480px) { .dl-row { width: 100%; } .dl-row .btn { width: 100%; } }
</style>
