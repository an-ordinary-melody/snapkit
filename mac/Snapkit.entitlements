<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The hardened runtime only loads libraries signed by the same Apple team. Snapkit is ad-hoc or
       self-signed (no team), so without this it can't load its own Sparkle.framework. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
